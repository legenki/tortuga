{
  "manifest_version": 3,
  "name": "Tortuga",
  "version": "0.2.0",
  "description": "Routes Incognito windows through Tor with the Tortuga helper, and downloads torrents. Hides your IP; it is not Tor Browser.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "120",
  "permissions": [
    "proxy",
    "privacy",
    "storage",
    "nativeMessaging",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Tortuga"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "links.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "key": ""
}
